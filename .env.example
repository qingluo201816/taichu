# Right Code 统一模型服务配置；真实密钥只写入本机 .env
RIGHTCODE_API_KEY=your-token
RIGHTCODE_RESPONSES_BASE_URL=https://www.right.codes/codex/v1
RIGHTCODE_CLAUDE_SALE_BASE_URL=https://right.codes/claude-sale
RIGHTCODE_DEEPSEEK_ANTHROPIC_BASE_URL=https://right.codes/deepseek/anthropic
RIGHTCODE_DEFAULT_MODEL_ID=deepseek-v4-pro
RIGHTCODE_REQUEST_TIMEOUT_SECONDS=180
RIGHTCODE_MAX_RETRIES=2

# 可选模型价格（每百万 Token，CNY）；未配置时费用显示为“未配置价格”
# 支持字段：input、cached_input、output、reasoning_output、currency
RIGHTCODE_MODEL_PRICES_JSON={}

# 可选：为十二个专业子 Agent 的逻辑模型角色分别指定模型 ID
# 示例：{"drafting":"deepseek-v4-pro","revision":"gpt-5.2"}
AGENT_MODEL_ROLES_JSON={}

# 服务配置
HOST=127.0.0.1
PORT=8000

# 单本小说数据目录
PROJECT_ASSETS_DIR=project_assets

# 知识沉淀效果评估配置；裁判模型留空时复用已配置的默认模型
EVALUATION_DATASETS_DIR=tests/fixtures/evaluations
EVALUATION_JUDGE_MODEL=

# 统一知识召回策略；可按消费者覆盖 top_k、字符预算、超时和后端选择
# 示例：{"writing_task":{"top_k":12,"max_content_chars":6000,"timeout_ms":5000}}
RETRIEVAL_POLICIES_JSON={}
RETRIEVAL_DEFAULT_RELEVANCE_STRATEGY=mongo_lexical

# 阶段 02 独立向量能力：只用于向量索引与专项评测，不替换或融合生产词法召回
QDRANT_IMAGE=qdrant/qdrant:v1.18.3
QDRANT_CONTAINER_NAME=taichu-qdrant
QDRANT_VOLUME_NAME=taichu_qdrant_data
QDRANT_URL=http://127.0.0.1:6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=taichu_knowledge_vectors
QDRANT_API_KEY=

# Qwen3-Embedding-4B 由本机 llama.cpp 提供 OpenAI 兼容接口，不调用云端模型 API
EMBEDDING_SERVER_HOME=E:/Taichu/Runtime/llama.cpp/b10066
EMBEDDING_MODEL_PATH=E:/Taichu/Models/Qwen3-Embedding-4B/Qwen3-Embedding-4B-Q4_K_M.gguf
EMBEDDING_LOG_DIR=E:/Taichu/Embedding/log
EMBEDDING_SERVER_PORT=8011
EMBEDDING_BASE_URL=http://127.0.0.1:8011/v1
EMBEDDING_MODEL_ID=Qwen3-Embedding-4B-Q4_K_M
EMBEDDING_DIMENSIONS=2560
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_CONTEXT_SIZE=8192
EMBEDDING_BATCH_SIZE=8192
EMBEDDING_GPU_LAYERS=99

# 独立向量索引与查询参数；只作用于重建命令和召回专项评测
VECTOR_DOCUMENT_BATCH_SIZE=16
VECTOR_EMBEDDING_INPUT_CHAR_BUDGET=24000
VECTOR_QUERY_CHAR_BUDGET=12000
VECTOR_CANDIDATE_MULTIPLIER=4
VECTOR_SCORE_THRESHOLD=0.50
VECTOR_COVERAGE_BONUS=0.02

# 阶段 04 通用写作助手运行记忆与上下文预算；运行记忆不是小说事实源
GENERAL_AGENT_RELATED_MEMORY_TOP_K=12
GENERAL_AGENT_RELATED_MEMORY_CHAR_BUDGET=12000
GENERAL_AGENT_WORKING_MEMORY_CHAR_BUDGET=24000
GENERAL_AGENT_MEMORY_AGE_DECAY_DAYS=30
GENERAL_AGENT_MEMORY_MINIMUM_RELEVANCE=0.01
GENERAL_AGENT_CONTEXT_CHAR_BUDGET=180000
GENERAL_AGENT_PROCESS_HISTORY_LIMIT=10
GENERAL_AGENT_PROCESS_HISTORY_CHAR_BUDGET=24000
GENERAL_AGENT_NODE_SUMMARY_CHAR_BUDGET=32000
GENERAL_AGENT_PLAN_SUMMARY_CHAR_BUDGET=24000
GENERAL_AGENT_MESSAGE_COMPACTION_THRESHOLD=20
GENERAL_AGENT_NODE_OUTPUT_COMPACTION_THRESHOLD=48000
GENERAL_AGENT_CAPABILITY_CATALOG_CHAR_BUDGET=80000

# MongoDB 本地运行配置
MONGODB_HOME=C:/path/to/mongodb
MONGODB_DATA_DIR=E:/Taichu/MongoDB/data/db
MONGODB_LOG_DIR=E:/Taichu/MongoDB/log
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=taichu
