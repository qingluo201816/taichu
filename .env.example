# LLM 配置
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 服务配置
HOST=127.0.0.1
PORT=8000

# 单本小说数据目录
PROJECT_ASSETS_DIR=project_assets

# 知识沉淀效果评估配置；裁判模型留空时复用已配置的默认模型
EVALUATION_DATASETS_DIR=tests/fixtures/evaluations
EVALUATION_JUDGE_MODEL=

# MongoDB 本地运行配置
MONGODB_HOME=C:/path/to/mongodb
MONGODB_DATA_DIR=E:/Taichu/MongoDB/data/db
MONGODB_LOG_DIR=E:/Taichu/MongoDB/log
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=taichu
