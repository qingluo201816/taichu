  "source_evidence": [
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 393,
      "quote_id": "quote_character_qin_haoxuan_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 373,
      "text": "在大田镇这群孩子们中，秦浩轩身手最为优秀"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2314,
      "quote_id": "quote_character_qin_haoxuan_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2284,
      "text": "秦浩轩终于确定自己的灵魂能在小蛇的躯体和自己本体来回穿梭附体"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2893,
      "quote_id": "quote_character_zhang_kuang_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2881,
      "text": "他就是和秦浩轩齐名的张狂"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 3275,
      "quote_id": "quote_character_zhang_kuang_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 3252,
      "text": "张狂本人也天赋异禀，十二岁时曾徒手杀了两头饿狼"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 1717,
      "quote_id": "quote_character_chen_laotou_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 1695,
      "text": "秦浩轩狩猎之余专门向药铺的陈老头学过辨识草药"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 576,
      "quote_id": "quote_character_wucai_xiaoshe_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 557,
      "text": "这条小蛇约摸半尺长，一身五彩斑斓的蛇皮"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2556,
      "quote_id": "quote_character_wucai_xiaoshe_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2536,
      "text": "比如百毒不侵，比如对一些灵药异草格外敏感"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 142,
      "quote_id": "quote_location_da_tian_zhen_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 102,
      "text": "背靠着小屿山的大田镇名字中带着耕田的美好愿望，却因田地稀少和贫瘠而不得不世代狩猎"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 1334,
      "quote_id": "quote_location_xiao_yu_shan_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 1319,
      "text": "大田镇世代狩猎，但都在外围转悠"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2366,
      "quote_id": "quote_location_xiao_yu_shan_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2355,
      "text": "人体若吸入毒瘴必死无疑"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 3951,
      "quote_id": "quote_location_chenjia_yaopu_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 3940,
      "text": "这是赶去陈家药铺卖么？"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 756,
      "quote_id": "quote_item_huangjing_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 741,
      "text": "这小块黄色物体是一枚珍贵的黄精"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 926,
      "quote_id": "quote_rule_qin_family_instruction_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 908,
      "text": "便给后人立了规矩，必须读书却不能做官"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2314,
      "quote_id": "quote_rule_qin_soul_swap_snake_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2294,
      "text": "灵魂能在小蛇的躯体和自己本体来回穿梭附体"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2717,
      "quote_id": "quote_rule_qin_soul_swap_snake_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2685,
      "text": "每次附身后都会留下后遗症——第二天筋疲力尽，打不起精神，只想睡觉"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 1856,
      "quote_id": "quote_event_qin_gains_snake_soul_ability_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 1826,
      "text": "一条五彩斑斓的小蛇从草丛里窜出来，一口咬在秦浩轩的右手虎口处"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2314,
      "quote_id": "quote_event_qin_gains_snake_soul_ability_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2284,
      "text": "秦浩轩终于确定自己的灵魂能在小蛇的躯体和自己本体来回穿梭附体"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2967,
      "quote_id": "quote_event_qin_stops_zhang_kuang_bullying_01",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2953,
      "text": "这就是不按时缴纳保险费的下场"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 3406,
      "quote_id": "quote_event_qin_stops_zhang_kuang_bullying_02",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 3391,
      "text": "逼得张狂硬生生收回要踢出去的脚"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 217,
      "quote_id": "quote_negative_chapter_001_001",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 206,
      "text": "正是晨练的少年们发出的"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2851,
      "quote_id": "quote_negative_chapter_001_002",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2838,
      "text": "狠狠踢着地上打滚的两个少年"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2976,
      "quote_id": "quote_negative_chapter_001_003",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2969,
      "text": "张狂身边的小弟"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 303,
      "quote_id": "quote_negative_chapter_001_004",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 290,
      "text": "被小屿山上的神仙们收为徒弟"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 1410,
      "quote_id": "quote_negative_chapter_001_005",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 1383,
      "text": "传说小屿山中不但居住着神仙，还有许多凶神恶煞的妖魔鬼怪"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 1648,
      "quote_id": "quote_negative_chapter_001_006",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 1639,
      "text": "却来到一个小山谷中"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 350,
      "quote_id": "quote_negative_chapter_001_007",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 335,
      "text": "大田镇西头一个还算气派的院落里"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2574,
      "quote_id": "quote_negative_chapter_001_008",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2557,
      "text": "一些豹子饿狼一看到小蛇吓得掉头就跑"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 464,
      "quote_id": "quote_negative_chapter_001_009",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 453,
      "text": "赚得不菲的银钱补贴家用"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 2556,
      "quote_id": "quote_negative_chapter_001_010",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 2545,
      "text": "对一些灵药异草格外敏感"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 756,
      "quote_id": "quote_negative_chapter_001_011",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 741,
      "text": "这小块黄色物体是一枚珍贵的黄精"
    },
    {
      "chapter_id": "chapter-f2a0007303a74f769e1609124c30da6b",
      "end_offset": 4264,
      "quote_id": "quote_negative_chapter_001_012",
      "source_hash": "6143c83e953af7a3405dde6cbbab7ea7b958e2f21fc975c23ceddd561baa6952",
      "start_offset": 4247,
      "text": "不久后就是山中神仙来挑选徒弟的日子"
    }
  ]
}
