  "source_evidence": [
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2222,
      "quote_id": "quote_character_qin_haoxuan_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2204,
      "text": "三十两就三十两，若没有您哪有我的今天"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 3010,
      "quote_id": "quote_character_qin_haoxuan_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2995,
      "text": "秦浩轩在报名薄上写上自己的大名"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2989,
      "quote_id": "quote_character_zhang_kuang_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2959,
      "text": "秦浩轩，我明天一定会被神仙们选中，到时候有些帐我们好好算一算"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 55,
      "quote_id": "quote_character_chen_laotou_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 32,
      "text": "陈老头每次都能药到病除，在大田镇拥有极高的声誉"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 1647,
      "quote_id": "quote_character_chen_laotou_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 1627,
      "text": "年近八十的他中气十足，一脸红润，健步如飞"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2222,
      "quote_id": "quote_character_chen_laotou_03",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2204,
      "text": "三十两就三十两，若没有您哪有我的今天"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2447,
      "quote_id": "quote_location_da_tian_zhen_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2426,
      "text": "镇长便遣人将镇上十六岁的适龄少年都聚集起来"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 18,
      "quote_id": "quote_location_chenjia_yaopu_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2,
      "text": "陈家药铺在大田镇无人不知无人不晓"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 83,
      "quote_id": "quote_location_chenjia_yaopu_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 60,
      "text": "北街一个不甚起眼的小店铺，高高挂出一个“药”字"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2505,
      "quote_id": "quote_location_pozi_ling_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2473,
      "text": "明天在坡子岭上，山上的神仙将在你们中间挑选出最优秀的苗子收作徒弟"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 960,
      "quote_id": "quote_item_huangjing_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 936,
      "text": "这里是一百两银子，只要小兄弟愿意将这块黄精卖给我"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2211,
      "quote_id": "quote_item_huangjing_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2204,
      "text": "三十两就三十两"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2447,
      "quote_id": "quote_rule_da_tian_selection_fee_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2432,
      "text": "镇上十六岁的适龄少年都聚集起来"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2560,
      "quote_id": "quote_rule_da_tian_selection_fee_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2530,
      "text": "一旦被神仙们选中，还将得到神仙们赠予的每年两百两白银的安家费"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2222,
      "quote_id": "quote_event_huangjing_trade_chain_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2204,
      "text": "三十两就三十两，若没有您哪有我的今天"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2505,
      "quote_id": "quote_event_da_tian_selection_announced_01",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2473,
      "text": "明天在坡子岭上，山上的神仙将在你们中间挑选出最优秀的苗子收作徒弟"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2671,
      "quote_id": "quote_event_da_tian_selection_announced_02",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2641,
      "text": "如果想要报名的，都来我这里报名，明天黎明时分便进发前往坡子岭"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 337,
      "quote_id": "quote_negative_chapter_002_001",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 329,
      "text": "就只有两个生面孔"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 523,
      "quote_id": "quote_negative_chapter_002_002",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 507,
      "text": "一个穿着青衫，留着小山羊胡的男子"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 1253,
      "quote_id": "quote_negative_chapter_002_003",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 1240,
      "text": "一直没有做声的另一个生面孔"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 98,
      "quote_id": "quote_negative_chapter_002_004",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 84,
      "text": "陈老头的学徒正在忙着切药制药"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 328,
      "quote_id": "quote_negative_chapter_002_005",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 310,
      "text": "一些受伤的猎户，前来卖药的零散采药人"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 72,
      "quote_id": "quote_negative_chapter_002_006",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 60,
      "text": "北街一个不甚起眼的小店铺"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 451,
      "quote_id": "quote_negative_chapter_002_007",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 440,
      "text": "秦浩轩来到陈家药铺门口"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2339,
      "quote_id": "quote_negative_chapter_002_008",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2322,
      "text": "领着一群少年来到镇上的酒家痛饮一顿"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 2467,
      "quote_id": "quote_negative_chapter_002_009",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 2448,
      "text": "在小镇的广场上宣布了这一振奋人心的消息"
    },
    {
      "chapter_id": "chapter-333d692f21224f15a5735317ee278132",
      "end_offset": 932,
      "quote_id": "quote_negative_chapter_002_010",
      "source_hash": "763fa70cc698f82ea6528b5e2bc7c21dffd5f576a104f5c7edb456a73d4f6404",
      "start_offset": 918,
      "text": "从包裹里取出五锭白灿灿的银子"
    }
  ]
}
