[
  {
    "quote_id": "quote_character_qin_haoxuan_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "你虽然能算过关，但资质实在一般",
    "start_offset": 2337,
    "end_offset": 2352,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_qin_haoxuan_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "秦浩轩的仙种虽然没死，但干涸得相当严重了",
    "start_offset": 2683,
    "end_offset": 2703,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_qin_haoxuan_03",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "片刻后，赵嘉龙宣布秦浩轩也被收录",
    "start_offset": 2872,
    "end_offset": 2888,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhang_kuang_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "张狂顺利通过第一关摸道骨",
    "start_offset": 1515,
    "end_offset": 1527,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhang_kuang_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "仙灵花以怒放的姿态，展示了张狂仙种的饱满和活力",
    "start_offset": 1846,
    "end_offset": 1869,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_xu_tunhu_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "本仙徐吞虎，这位乃我师兄赵嘉龙",
    "start_offset": 843,
    "end_offset": 858,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_xu_tunhu_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "两道白光从东方天际破雾腾云，御剑而来",
    "start_offset": 243,
    "end_offset": 261,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhao_jialong_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "本仙徐吞虎，这位乃我师兄赵嘉龙",
    "start_offset": 843,
    "end_offset": 858,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhao_jialong_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "片刻后，赵嘉龙宣布秦浩轩也被收录",
    "start_offset": 2872,
    "end_offset": 2888,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhang_yang_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "张狂的族弟兼小弟张扬，竟然也通过考核",
    "start_offset": 3003,
    "end_offset": 3021,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_character_zhang_yang_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "证明张扬的仙种比秦浩轩更有活力",
    "start_offset": 3052,
    "end_offset": 3067,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_location_da_tian_zhen_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "大田镇今年有四十一名适龄少年",
    "start_offset": 527,
    "end_offset": 541,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_location_chenjia_yaopu_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "这不是昨天在陈家药铺卖黄精的那少年么？",
    "start_offset": 700,
    "end_offset": 719,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_location_pozi_ling_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "坡子岭是小屿山内山与外围的分界点，是一块平坦的草地",
    "start_offset": 203,
    "end_offset": 228,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_location_da_yu_shan_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "宗门位于大屿山黄帝峰",
    "start_offset": 4201,
    "end_offset": 4211,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_location_huangdi_feng_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "宗门位于大屿山黄帝峰",
    "start_offset": 4201,
    "end_offset": 4211,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_faction_taichu_jiao_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "上天曾降下仙班仙谱，赐名‘至上仙尊真乙太初教’，一般称为太初教",
    "start_offset": 4163,
    "end_offset": 4194,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_faction_taichu_jiao_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "弟子门人上万，乃是翔龙国唯一仙门",
    "start_offset": 4212,
    "end_offset": 4228,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_faction_xianglong_guo_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "乃是翔龙国唯一仙门",
    "start_offset": 4219,
    "end_offset": 4228,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_faction_xianglong_guo_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "历代皇帝登基，都必须报备掌教批准同意",
    "start_offset": 4240,
    "end_offset": 4258,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_item_huangjing_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "后来在陈老头手上以五百两天价买下那枚黄精",
    "start_offset": 377,
    "end_offset": 397,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_item_xianling_hua_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "如果仙灵花毫无动静则说明仙种已死，仙灵花开得越茂密则证明仙种越饱满",
    "start_offset": 1756,
    "end_offset": 1789,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_item_xianling_hua_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "仙灵花以怒放的姿态，展示了张狂仙种的饱满和活力",
    "start_offset": 1846,
    "end_offset": 1869,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_rule_taichu_selection_two_tests_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "选苗分根骨两项！第一项摸道骨，第二项测仙种，两项都过关则入选",
    "start_offset": 882,
    "end_offset": 912,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_rule_taichu_selection_two_tests_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "所谓摸道骨就是对骨骼经脉进行初步的试探",
    "start_offset": 1026,
    "end_offset": 1045,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_rule_xianzhong_age_life_check_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "几乎每个人都有仙种，但很多人的仙种在他出生后就死了",
    "start_offset": 1133,
    "end_offset": 1158,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_rule_xianzhong_age_life_check_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "因为要满十六岁才能灌输吸收天地灵气，所以必须满十六岁才能修仙",
    "start_offset": 1184,
    "end_offset": 1214,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_huangjing_trade_chain_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "后来在陈老头手上以五百两天价买下那枚黄精",
    "start_offset": 377,
    "end_offset": 397,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_pozi_selection_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "大田镇今年有四十一名适龄少年，请两位仙长挑选",
    "start_offset": 527,
    "end_offset": 549,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_pozi_selection_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "今年的大田镇一举出了三名仙人弟子",
    "start_offset": 3274,
    "end_offset": 3290,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_da_tian_three_selected_leave_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "这是你们的安家费，妥善安置后，明天清晨镇口见",
    "start_offset": 3357,
    "end_offset": 3379,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_da_tian_three_selected_leave_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "三名少年在无数家乡父老的簇拥下来到镇口",
    "start_offset": 3597,
    "end_offset": 3616,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_xu_zhao_sword_arrival_01",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "两道白光从东方天际破雾腾云，御剑而来",
    "start_offset": 243,
    "end_offset": 261,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_xu_zhao_sword_arrival_02",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "他们脚下的飞剑绕场一周，驱散四周雾气，形成一小块真空界",
    "start_offset": 436,
    "end_offset": 463,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_event_xu_zhao_sword_arrival_03",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "飞剑随后自动飞回他们背后剑鞘",
    "start_offset": 464,
    "end_offset": 478,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_001",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "第一个少年走上去接受测试",
    "start_offset": 940,
    "end_offset": 952,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_002",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "那名通过摸骨测试的少年",
    "start_offset": 1240,
    "end_offset": 1251,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_003",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "四十一名少年，连同护送的二十个猎户",
    "start_offset": 555,
    "end_offset": 572,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_004",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "护送的二十个猎户",
    "start_offset": 564,
    "end_offset": 572,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_005",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "凡骨……下一个",
    "start_offset": 1013,
    "end_offset": 1020,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_006",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "赵嘉龙哈了一道仙灵之气打入张狂体内",
    "start_offset": 1710,
    "end_offset": 1727,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_007",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "五张黄色符纸分别贴在五匹马屁股上",
    "start_offset": 3684,
    "end_offset": 3700,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_008",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "镇长连夜在县城里购了五匹好马",
    "start_offset": 3643,
    "end_offset": 3657,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  },
  {
    "quote_id": "quote_negative_chapter_003_009",
    "chapter_id": "chapter-f3a712cf4fdf404b935942fe3ff297a0",
    "text": "飞剑随后自动飞回他们背后剑鞘",
    "start_offset": 464,
    "end_offset": 478,
    "source_hash": "f2f707c4f29a5319851b440da26076ca6659244f2f9b705a582ec708bc527dba"
  }
]
